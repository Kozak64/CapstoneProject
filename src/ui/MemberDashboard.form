<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.MemberDashboard">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="660" height="460"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="a1001" class="javax.swing.JLabel" binding="lblDashboardTitle">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="16" style="1"/>
          <text value="Member Dashboard"/>
        </properties>
      </component>
      <component id="a1002" class="javax.swing.JLabel" binding="lblPlanInfo">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="12" style="0"/>
          <text value="Current Plan: None | Expiry Date: N/A"/>
        </properties>
      </component>
      <tabbedpane id="a1003" binding="tabbedPane">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="600" height="300"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="b2001" binding="tabBookSession" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
            <margin top="12" left="12" bottom="12" right="12"/>
            <constraints>
              <tabbedpane title="Book Session"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <scrollpane id="b2002">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="b2003" class="javax.swing.JTable" binding="tblSessions">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
              <component id="b2004" class="javax.swing.JButton" binding="btnBookSession">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Book Selected Session"/>
                </properties>
              </component>
              <component id="b2005" class="javax.swing.JButton" binding="btnCancelSession">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Cancel Session"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="c3001" binding="tabRenewPlan" layout-manager="GridLayoutManager" row-count="5" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="10">
            <margin top="25" left="120" bottom="25" right="120"/>
            <constraints>
              <tabbedpane title="Renew Plan / Pay"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="c3002" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Select Membership Plan"/>
                </properties>
              </component>
              <component id="c3003" class="javax.swing.JComboBox" binding="cmbPlans">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <component id="c3004" class="javax.swing.JComboBox" binding="cmbPaymentMethod">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <component id="c3005" class="javax.swing.JLabel" binding="lblPlanPrice">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font style="1"/>
                  <text value="Amount Due: PHP 1,200.00"/>
                </properties>
              </component>
              <component id="c3006" class="javax.swing.JButton" binding="btnRenewPay">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Process Payment &amp; Renew"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="d4001" binding="tabAttendance" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="12" left="12" bottom="12" right="12"/>
            <constraints>
              <tabbedpane title="View Attendance"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <scrollpane id="d4002">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="d4003" class="javax.swing.JTable" binding="tblAttendance">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
        </children>
      </tabbedpane>
      <component id="a1004" class="javax.swing.JButton" binding="btnLogout">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="140" height="-1"/>
          </grid>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>

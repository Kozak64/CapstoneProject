<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.TrainerDashboard">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="10">
    <margin top="20" left="25" bottom="20" right="25"/>
    <constraints>
      <xy x="20" y="20" width="500" height="428"/>
    </constraints>
    <properties>
      <background color="-16118249"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="d335c" class="javax.swing.JLabel" binding="DashboardTitle">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="16" style="1"/>
          <foreground color="-1"/>
          <text value="Trainer Dashboard"/>
        </properties>
      </component>
      <component id="3d6c4" class="javax.swing.JLabel" binding="Subtitle">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="12"/>
          <foreground color="-7037256"/>
          <text value="Label"/>
        </properties>
      </component>
      <tabbedpane id="1a7a" binding="tabbedPane1" default-binding="true">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="600" height="300"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="3e49" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
            <margin top="12" left="12" bottom="12" right="12"/>
            <constraints>
              <tabbedpane title="My Session"/>
            </constraints>
            <properties>
              <background color="-15854299"/>
            </properties>
            <border type="none"/>
            <children>
              <scrollpane id="4c6a7">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="1587" class="javax.swing.JTable" binding="Sessiontabel">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
              <component id="8fa73" class="javax.swing.JButton" binding="updateScheduleButton" default-binding="true">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Update Schedule"/>
                </properties>
              </component>
              <component id="15cad" class="javax.swing.JButton" binding="cancelSessionButton" default-binding="true">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Cancel Session"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="bf8e2" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
            <margin top="12" left="12" bottom="12" right="12"/>
            <constraints>
              <tabbedpane title="Mark Attendance"/>
            </constraints>
            <properties>
              <background color="-15854299"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="76962" class="javax.swing.JComboBox" binding="cmSessionFilter">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <scrollpane id="66ceb">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="af847" class="javax.swing.JTable" binding="AttendanceTabel">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
              <component id="cf1ea" class="javax.swing.JButton" binding="markPresentButton" default-binding="true">
